<Page x:Class="UWP_Port.DirectXPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#FF0D1117">
  <Page.Resources>
    <SolidColorBrush x:Key="Panel" Color="#F21A222C"/><SolidColorBrush x:Key="Accent" Color="#FF4CC38A"/>
    <Style TargetType="Button"><Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="14,9"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
  </Page.Resources>
  <Grid>
    <SwapChainPanel x:Name="swapChainPanel"/>
    <Grid x:Name="launcherPanel" Background="#E60D1117">
      <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Panel}" BorderBrush="#FF334152" BorderThickness="0,0,1,0" Padding="22">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="XEMU UWP" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource Accent}"/><TextBlock Text="Original Xbox" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,6,0,30"/></StackPanel>
          <StackPanel Grid.Row="1"><Button Content="Home" Tag="0" Click="NavigationButton_Click"/><Button Content="Files" Tag="1" Click="NavigationButton_Click"/><Button Content="Storage" Tag="2" Click="NavigationButton_Click"/><Button Content="Settings" Tag="3" Click="NavigationButton_Click"/><Button Content="Network" Tag="4" Click="NavigationButton_Click"/><Button Content="VLan/VPN" Tag="5" Click="NavigationButton_Click"/><Button Content="Logs" Tag="6" Click="NavigationButton_Click"/></StackPanel>
          <StackPanel Grid.Row="2"><TextBlock x:Name="hostStatus" Text="● READY" Foreground="{StaticResource Accent}" FontFamily="Consolas"/><TextBlock Text="Mesa · D3D12" Foreground="#FFAAB8C5" FontSize="12"/></StackPanel>
        </Grid>
      </Border>
      <Pivot x:Name="toolTabs" Grid.Column="1">
        <PivotItem>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="38" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
              <TextBlock Text="xemu para Xbox/UWP" FontSize="38" FontWeight="SemiBold" Foreground="White"/>
              <TextBlock Text="Open-source original Xbox emulator adapted for embedded execution in UWP applications." Foreground="#FFC6D0DA" FontSize="17" TextWrapping="Wrap"/>
              <Border Background="{StaticResource Panel}" BorderBrush="#FF334152" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,8,0,0">
                <StackPanel Spacing="8"><TextBlock Text="Rendering" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock Text="NV2A → OpenGL/Gallium, Vulkan/DZN, or native D3D12 → D3D12/DXGI" FontFamily="Consolas" Foreground="White" TextWrapping="Wrap"/><TextBlock Text="All renderers present the Xbox framebuffer directly in the UWP-Port SwapChainPanel." Foreground="#FFAAB8C5" TextWrapping="Wrap"/></StackPanel>
              </Border>
              <Border Background="{StaticResource Panel}" BorderBrush="#FF334152" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel Spacing="8"><TextBlock Text="UWP integration" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock Text="Brokered files, Xbox controller input through Windows.Gaming.Input, WASAPI audio, and a non-blocking emulation loop." Foreground="White" TextWrapping="Wrap"/><TextBlock Text="Select the required files on the Files tab to enable startup." Foreground="#FFAAB8C5" TextWrapping="Wrap"/></StackPanel>
              </Border>
              <Border Background="{StaticResource Panel}" BorderBrush="#FF334152" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel Spacing="8"><TextBlock Text="Required files" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock Text="Flash BIOS, MCPX boot ROM, and Xbox hard disk." Foreground="White" TextWrapping="Wrap"/><TextBlock Text="DVD/XISO and EEPROM are optional. xemu can generate the EEPROM automatically." Foreground="#FFAAB8C5" TextWrapping="Wrap"/></StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </PivotItem>
        <PivotItem>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Padding="38" Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Xbox files" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock Text="Files are opened through the Windows broker." Foreground="#FFC6D0DA"/>
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Select flash ROM (BIOS)" Tag="flash" Click="SelectFile_Click"/><TextBlock x:Name="flashFileStatus" Grid.Column="1" Text="Not selected" Foreground="#FFAAB8C5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Select MCPX boot ROM" Tag="bootrom" Click="SelectFile_Click"/><TextBlock x:Name="bootromFileStatus" Grid.Column="1" Text="Not selected" Foreground="#FFAAB8C5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Select hard disk" Tag="hdd" Click="SelectFile_Click"/><TextBlock x:Name="hddFileStatus" Grid.Column="1" Text="Not selected" Foreground="#FFAAB8C5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Select EEPROM" Tag="eeprom" Click="SelectFile_Click"/><TextBlock x:Name="eepromFileStatus" Grid.Column="1" Text="Automatic" Foreground="#FFAAB8C5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Select DVD/XISO" Tag="dvd" Click="SelectFile_Click"/><TextBlock x:Name="dvdFileStatus" Grid.Column="1" Text="Not selected" Foreground="#FFAAB8C5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
            <TextBlock x:Name="requiredFilesStatus" Text="Select BIOS, MCPX, and hard disk to start. DVD/XISO is optional." Foreground="#FFFFC857" TextWrapping="Wrap" Margin="0,14,0,0"/>
            <Button x:Name="startButton" Content="▶ Start xemu" Background="{StaticResource Accent}" Click="StartXemu_Click" IsEnabled="False" Margin="0,4,0,20"/>
          </StackPanel>
          </ScrollViewer>
        </PivotItem>
        <PivotItem>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Padding="38" Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Storage" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock Text="Optional locations and memory units accessed through the Windows broker." Foreground="#FFC6D0DA" TextWrapping="Wrap"/>
            <TextBlock Text="Folders" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,14,0,0"/>
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Screenshots folder" Tag="screenshots" Click="SelectFolder_Click"/><TextBlock x:Name="screenshotFolderStatus" Grid.Column="1" Text="Application default" Foreground="#FFAAB8C5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Games folder" Tag="games" Click="SelectFolder_Click"/><TextBlock x:Name="gamesFolderStatus" Grid.Column="1" Text="Not selected" Foreground="#FFAAB8C5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
            <TextBlock Text="Memory Units" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,14,0,0"/>
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Port 1 · Slot A" Tag="xmu-p1a" Click="SelectFile_Click"/><TextBlock x:Name="xmuP1AStatus" Grid.Column="1" Text="Not selected" Foreground="#FFAAB8C5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Port 1 · Slot B" Tag="xmu-p1b" Click="SelectFile_Click"/><TextBlock x:Name="xmuP1BStatus" Grid.Column="1" Text="Not selected" Foreground="#FFAAB8C5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Port 2 · Slot A" Tag="xmu-p2a" Click="SelectFile_Click"/><TextBlock x:Name="xmuP2AStatus" Grid.Column="1" Text="Not selected" Foreground="#FFAAB8C5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Port 2 · Slot B" Tag="xmu-p2b" Click="SelectFile_Click"/><TextBlock x:Name="xmuP2BStatus" Grid.Column="1" Text="Not selected" Foreground="#FFAAB8C5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Port 3 · Slot A" Tag="xmu-p3a" Click="SelectFile_Click"/><TextBlock x:Name="xmuP3AStatus" Grid.Column="1" Text="Not selected" Foreground="#FFAAB8C5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Port 3 · Slot B" Tag="xmu-p3b" Click="SelectFile_Click"/><TextBlock x:Name="xmuP3BStatus" Grid.Column="1" Text="Not selected" Foreground="#FFAAB8C5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Port 4 · Slot A" Tag="xmu-p4a" Click="SelectFile_Click"/><TextBlock x:Name="xmuP4AStatus" Grid.Column="1" Text="Not selected" Foreground="#FFAAB8C5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Port 4 · Slot B" Tag="xmu-p4b" Click="SelectFile_Click"/><TextBlock x:Name="xmuP4BStatus" Grid.Column="1" Text="Not selected" Foreground="#FFAAB8C5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
          </StackPanel>
          </ScrollViewer>
        </PivotItem>
        <PivotItem>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="38" Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
              <TextBlock Text="xemu settings" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
              <TextBlock Text="Changes are saved automatically and applied to the DLL on the next startup." Foreground="#FFC6D0DA"/>

              <TextBlock Text="General and performance" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,12,0,0"/>
              <CheckBox x:Name="skipBootAnimation" Content="Skip boot animation" Foreground="White"/>
              <CheckBox x:Name="hardFpu" Content="Hardware-accelerated FPU emulation" Foreground="White"/>
              <CheckBox x:Name="cacheShaders" Content="Save shader cache to disk" Foreground="White"/>
              <CheckBox x:Name="filterSnapshots" Content="Show only snapshots for the current game" Foreground="White"/>
              <TextBlock Text="UWP package updates are managed by the package distribution channel." Foreground="#FFAAB8C5" TextWrapping="Wrap"/>

              <TextBlock Text="Input" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,12,0,0"/>
              <CheckBox x:Name="autoBind" Content="Bind controllers automatically" Foreground="White"/>
              <CheckBox x:Name="invertLeftX" Content="Invert left stick X axis" Foreground="White"/>
              <CheckBox x:Name="invertLeftY" Content="Invert left stick Y axis" Foreground="White"/>
              <CheckBox x:Name="invertRightX" Content="Invert right stick X axis" Foreground="White"/>
              <CheckBox x:Name="invertRightY" Content="Invert right stick Y axis" Foreground="White"/>
              <TextBlock Text="Ports and expansions" Foreground="White" FontWeight="SemiBold"/>
              <Grid ColumnSpacing="10" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="220"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Emulated controller" Foreground="#FFAAB8C5"/><TextBlock Grid.Row="0" Grid.Column="2" Text="Slot A" Foreground="#FFAAB8C5"/><TextBlock Grid.Row="0" Grid.Column="3" Text="Slot B" Foreground="#FFAAB8C5"/>
                <TextBlock Grid.Row="1" Text="Port 1" Foreground="White" VerticalAlignment="Center"/><ComboBox x:Name="port1Driver" Grid.Row="1" Grid.Column="1"><ComboBoxItem Content="Xbox Controller (Duke)"/><ComboBoxItem Content="Xbox Controller S"/></ComboBox><ComboBox x:Name="port1SlotA" Grid.Row="1" Grid.Column="2"><ComboBoxItem Content="None"/><ComboBoxItem Content="Memory Unit"/></ComboBox><ComboBox x:Name="port1SlotB" Grid.Row="1" Grid.Column="3"><ComboBoxItem Content="None"/><ComboBoxItem Content="Memory Unit"/></ComboBox>
                <TextBlock Grid.Row="2" Text="Port 2" Foreground="White" VerticalAlignment="Center"/><ComboBox x:Name="port2Driver" Grid.Row="2" Grid.Column="1"><ComboBoxItem Content="Xbox Controller (Duke)"/><ComboBoxItem Content="Xbox Controller S"/></ComboBox><ComboBox x:Name="port2SlotA" Grid.Row="2" Grid.Column="2"><ComboBoxItem Content="None"/><ComboBoxItem Content="Memory Unit"/></ComboBox><ComboBox x:Name="port2SlotB" Grid.Row="2" Grid.Column="3"><ComboBoxItem Content="None"/><ComboBoxItem Content="Memory Unit"/></ComboBox>
                <TextBlock Grid.Row="3" Text="Port 3" Foreground="White" VerticalAlignment="Center"/><ComboBox x:Name="port3Driver" Grid.Row="3" Grid.Column="1"><ComboBoxItem Content="Xbox Controller (Duke)"/><ComboBoxItem Content="Xbox Controller S"/></ComboBox><ComboBox x:Name="port3SlotA" Grid.Row="3" Grid.Column="2"><ComboBoxItem Content="None"/><ComboBoxItem Content="Memory Unit"/></ComboBox><ComboBox x:Name="port3SlotB" Grid.Row="3" Grid.Column="3"><ComboBoxItem Content="None"/><ComboBoxItem Content="Memory Unit"/></ComboBox>
                <TextBlock Grid.Row="4" Text="Port 4" Foreground="White" VerticalAlignment="Center"/><ComboBox x:Name="port4Driver" Grid.Row="4" Grid.Column="1"><ComboBoxItem Content="Xbox Controller (Duke)"/><ComboBoxItem Content="Xbox Controller S"/></ComboBox><ComboBox x:Name="port4SlotA" Grid.Row="4" Grid.Column="2"><ComboBoxItem Content="None"/><ComboBoxItem Content="Memory Unit"/></ComboBox><ComboBox x:Name="port4SlotB" Grid.Row="4" Grid.Column="3"><ComboBoxItem Content="None"/><ComboBoxItem Content="Memory Unit"/></ComboBox>
              </Grid>

              <TextBlock Text="Video" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,12,0,0"/>
              <TextBlock Text="Renderer" Foreground="White"/><ComboBox x:Name="renderer"><ComboBoxItem Content="OpenGL (Mesa Gallium D3D12)"/><ComboBoxItem Content="Vulkan (Mesa DZN D3D12)"/><ComboBoxItem Content="Direct3D 12 (native)"/></ComboBox>
              <TextBlock Text="Internal resolution" Foreground="White"/><ComboBox x:Name="surfaceScale"><ComboBoxItem Content="1x (native)"/><ComboBoxItem Content="2x"/><ComboBoxItem Content="3x"/><ComboBoxItem Content="4x"/><ComboBoxItem Content="5x"/><ComboBoxItem Content="6x"/></ComboBox>
              <TextBlock Text="Filtering" Foreground="White"/><ComboBox x:Name="filtering"><ComboBoxItem Content="Linear"/><ComboBoxItem Content="Nearest"/></ComboBox>
              <TextBlock Text="Display mode" Foreground="White"/><ComboBox x:Name="displayFit"><ComboBoxItem Content="Center"/><ComboBoxItem Content="Scale while preserving aspect ratio"/><ComboBoxItem Content="Stretch"/></ComboBox>
              <TextBlock Text="Aspect ratio" Foreground="White"/><ComboBox x:Name="aspectRatio"><ComboBoxItem Content="Native"/><ComboBoxItem Content="Automatic"/><ComboBoxItem Content="4:3"/><ComboBoxItem Content="16:9"/></ComboBox>
              <CheckBox x:Name="vsync" Content="Vertical synchronization" Foreground="White"/>
              <CheckBox x:Name="showNotifications" Content="Show notifications" Foreground="White"/>
              <CheckBox x:Name="useAnimations" Content="Interface animations" Foreground="White"/>
              <CheckBox x:Name="autoUiScale" Content="Automatic interface scale" Foreground="White"/>
              <TextBlock Text="Manual interface scale" Foreground="White"/><Slider x:Name="uiScale" Minimum="1" Maximum="3" StepFrequency="0.25" TickFrequency="0.25" TickPlacement="BottomRight"/>
              <TextBlock Text="UWP presentation is managed by the SwapChainPanel. Desktop window size, exclusive fullscreen, xemu menu bar, and cursor timeout do not apply." Foreground="#FFAAB8C5" TextWrapping="Wrap" Margin="0,4,0,0"/>

              <TextBlock Text="Audio" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,12,0,0"/>
              <CheckBox x:Name="useDsp" Content="Real-time DSP" Foreground="White"/>
              <CheckBox x:Name="useHrtf" Content="HRTF spatial audio" Foreground="White"/>
              <TextBlock Text="Volume limit" Foreground="White"/><Slider x:Name="volumeLimit" Minimum="0" Maximum="1" StepFrequency="0.05" TickFrequency="0.25" TickPlacement="BottomRight"/>
              <TextBlock Text="UWP uses the portable DSP interpreter and one deterministic voice worker." Foreground="#FFAAB8C5" TextWrapping="Wrap"/>

              <TextBlock Text="System" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,12,0,0"/>
              <TextBlock Text="Xbox memory" Foreground="White"/><ComboBox x:Name="memoryLimit"><ComboBoxItem Content="64 MB"/><ComboBoxItem Content="128 MB"/></ComboBox>
              <TextBlock Text="Video cable (AV Pack)" Foreground="White"/><ComboBox x:Name="avPack"><ComboBoxItem Content="SCART"/><ComboBoxItem Content="HDTV"/><ComboBoxItem Content="VGA"/><ComboBoxItem Content="RFU"/><ComboBoxItem Content="S-Video"/><ComboBoxItem Content="Composite"/><ComboBoxItem Content="None"/></ComboBox>
              <TextBlock Text="Selecting AV Pack 'None' intentionally disables Xbox video output." Foreground="#FFFFC857" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
        </PivotItem>
        <PivotItem>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="38" Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
              <TextBlock Text="Network" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
              <TextBlock Text="Configure the Xbox network backend. Network changes are applied only after selecting Save settings." Foreground="#FFC6D0DA" TextWrapping="Wrap"/>
              <CheckBox x:Name="networkEnabled" Content="Enable network" Foreground="White"/>
              <TextBlock Text="Backend" Foreground="White"/><ComboBox x:Name="networkBackend"><ComboBoxItem Content="NAT (Internet / Insignia)"/><ComboBoxItem Content="UDP tunnel"/></ComboBox>
              <TextBlock Text="NAT provides DHCP, DNS, TCP and UDP access inside the UWP sandbox. UDP tunnel connects two xemu instances and requires reachable endpoints." Foreground="#FFB7C2D0" TextWrapping="Wrap"/>
              <TextBlock Text="Local UDP address" Foreground="White"/><TextBox x:Name="udpBindAddress" PlaceholderText="0.0.0.0:9368"/>
              <TextBlock Text="UDP tunnel server" Foreground="White"/>
              <ComboBox x:Name="udpServer" SelectionChanged="UdpServer_SelectionChanged">
                <ComboBoxItem Content="Manual address"/>
                <ComboBoxItem Content="US West — us-west-1.lan.xemu.app:9938"/>
                <ComboBoxItem Content="US East — us-east-1.lan.xemu.app:9938"/>
                <ComboBoxItem Content="Germany — de-1.lan.xemu.app:9938"/>
              </ComboBox>
              <TextBlock Text="Remote UDP address" Foreground="White"/><TextBox x:Name="udpRemoteAddress" PlaceholderText="Address:port"/>
              <TextBlock Text="NAT forwarding (one rule per line: tcp|udp,host port,Xbox port)" Foreground="White"/><TextBox x:Name="natForwardPorts" AcceptsReturn="True" Height="90" TextWrapping="NoWrap" PlaceholderText="tcp,8080,80" FontFamily="Consolas"/>
              <TextBlock Text="PCAP is not offered because it is unavailable in the UWP build." Foreground="#FFAAB8C5"/>
              <Button Content="Save settings" Background="{StaticResource Accent}" Click="SaveSettings_Click" Margin="0,16,0,30"/>
            </StackPanel>
          </ScrollViewer>
        </PivotItem>
        <PivotItem>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="38" Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
              <TextBlock Text="VLan/VPN" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
              <TextBlock Text="Create or join a private virtual Xbox LAN. The host provides Internet access through SLiRP; direct UDP is preferred and the configured service is used as relay fallback." Foreground="#FFC6D0DA" TextWrapping="Wrap"/>
              <CheckBox x:Name="vlanEnabled" Content="Enable VLan/VPN when xemu starts" Foreground="White"/>
              <TextBlock Text="Role" Foreground="White"/>
              <ComboBox x:Name="vlanRole"><ComboBoxItem Content="Host (SLiRP gateway)"/><ComboBoxItem Content="Client"/></ComboBox>
              <TextBlock Text="Coordinator/relay UDP address" Foreground="White"/>
              <TextBox x:Name="vlanCoordinator" PlaceholderText="relay.example.com:9939"/>
              <TextBlock Text="Room code" Foreground="White"/>
              <TextBox x:Name="vlanRoomCode" PlaceholderText="32 hexadecimal characters" MaxLength="32"/>
              <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Create room code" Click="CreateVlanRoom_Click" Background="{StaticResource Accent}"/><Button Content="Save settings" Click="SaveVlanSettings_Click"/></StackPanel>
              <TextBlock x:Name="vlanStatus" Text="Disconnected" Foreground="#FFAAB8C5" TextWrapping="Wrap"/>
              <TextBlock Text="Every participant must use the same coordinator and room code. Keep the room code private. Relay traffic is not encrypted." Foreground="#FFAAB8C5" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
        </PivotItem>
        <PivotItem>
          <Grid Padding="38" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Logs" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock Grid.Row="1" Text="ApplicationData\LocalFolder\xemu.log — latest 256 KB" FontFamily="Consolas" Foreground="{StaticResource Accent}"/>
            <TextBlock x:Name="errorText" Grid.Row="2" Foreground="#FFFF8A80" TextWrapping="Wrap"/>
            <TextBox x:Name="logText" Grid.Row="3" FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
          </Grid>
        </PivotItem>
      </Pivot>
    </Grid>
    <Border x:Name="fpsOverlay" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,10,10,0" Padding="6,3" CornerRadius="3"
            Background="#A0000000" IsHitTestVisible="False" Visibility="Collapsed">
      <TextBlock x:Name="fpsCounter" Text="0 FPS  0 MSPF" Foreground="White"
                 FontFamily="Consolas" FontSize="12"/>
    </Border>
  </Grid>
</Page>
